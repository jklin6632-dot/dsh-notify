{
  "name": "dsh-notify",
  "version": "1.3.0",
  "type": "module",
  "description": "A persistent corner card for DeepSeek Harness (DSH): it appears when a turn ends, an approval is requested, or the agent is waiting for your answer, and it stays put until you deal with it.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "windows",
    "desktop"
  ],
  "license": "MIT",
  "author": "lxj5820",
  "os": [
    "win32"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "popup.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklin6632-dot/dsh-notify.git"
  },
  "bugs": {
    "url": "https://github.com/jklin6632-dot/dsh-notify/issues"
  },
  "homepage": "https://github.com/jklin6632-dot/dsh-notify#readme"
}
